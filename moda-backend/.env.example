DATABASE_URL=postgresql+psycopg2://moda:moda@localhost:5432/moda

# Embedding model (OpenCLIP)
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
EMBEDDING_DIM=512

# User embedding blend weights
# user = alpha*quiz + beta*mean(liked) - gamma*mean(disliked), then L2-normalized
ALPHA_QUIZ=0.5
BETA_LIKED=0.4
GAMMA_DISLIKED=0.2

# Recommendation behavior
DEFAULT_FEED_SIZE=20
DIVERSITY_LAMBDA=0.3   # 0 = pure relevance, 1 = pure diversity (MMR re-ranking)
FEEDBACK_HALF_LIFE_DAYS=14   # recency decay for likes/dislikes; <= 0 disables
TAG_AFFINITY_BOOST=0.05      # score bonus per tag matching stated taste (max 2 tags)

# Dataset fetching (scripts/fetch_dataset.py) — free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Auth — set a long random value for anything beyond local dev
JWT_SECRET=dev-only-jwt-secret-change-me-for-production-use
JWT_EXPIRES_MINUTES=10080
