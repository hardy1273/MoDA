DATABASE_URL=postgresql+psycopg2://moda:moda@localhost:5432/moda

# Embedding model (OpenCLIP). Default: fashion-fine-tuned CLIP (512-dim).
# Generic fallback: CLIP_MODEL=ViT-B-32, CLIP_PRETRAINED=laion2b_s34b_b79k.
# Changing the model requires re-ingesting outfits and items with --update.
CLIP_MODEL=hf-hub:Marqo/marqo-fashionCLIP
CLIP_PRETRAINED=
EMBEDDING_DIM=512

# User embedding blend weights
# user = alpha*quiz + beta*mean(liked) - gamma*mean(disliked), then L2-normalized
ALPHA_QUIZ=0.5
BETA_LIKED=0.4
GAMMA_DISLIKED=0.2

# Recommendation behavior
DEFAULT_FEED_SIZE=20
DIVERSITY_LAMBDA=0.3   # 0 = pure relevance, 1 = pure diversity (MMR re-ranking)
FEEDBACK_HALF_LIFE_DAYS=14   # recency decay for likes/dislikes; <= 0 disables
TAG_AFFINITY_BOOST=0.05      # score bonus per tag matching stated taste (max 2 tags)
IMPRESSION_PENALTY=0.02      # score penalty per prior view of an outfit (capped at 5)

# Dataset fetching (scripts/fetch_dataset.py) — free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Auth — set a long random value for anything beyond local dev
JWT_SECRET=dev-only-jwt-secret-change-me-for-production-use
JWT_EXPIRES_MINUTES=10080

# Payments & payouts (Stripe Connect Express).
# Leave STRIPE_SECRET_KEY empty to run the simulated provider — the full
# seller onboarding and payout flow still works, nothing real moves.
# Test-mode key (sk_test_...) from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
CURRENCY=usd
PLATFORM_FEE_BPS=1000     # 1000 = 10% commission
APP_BASE_URL=http://localhost:3000
